digraph ER {
graph [rankdir=LR, fontname="Arial", nodesep=0.35, ranksep=1.3, pad=0.4, bgcolor="white", label=<<FONT POINT-SIZE="20"><B>AforoFit · Modelo de datos implementado en Supabase</B></FONT><BR/><FONT POINT-SIZE="12">9 tablas en el esquema public, con Row Level Security en todas · 23 de noviembre de 2026</FONT>>, labelloc=t];
node [shape=plaintext, fontname="Arial"]; edge [fontname="Arial", fontsize=10, color="#444444"];
auth_users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="4" COLOR="#999999" STYLE="dashed"><TR><TD><I>auth.users</I></TD></TR><TR><TD><FONT POINT-SIZE="10">Supabase Auth</FONT></TD></TR></TABLE>>];

subgraph cluster_flujo { label=<<B>Flujo de ingreso</B>>; fontsize=13; style="rounded"; color="#BBBBBB"; tarjetas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E5F4E4"><B>tarjetas</B></TD></TR><TR><TD ALIGN="LEFT" PORT="uid"><FONT POINT-SIZE="11"><B>uid</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alumno_id"><FONT POINT-SIZE="11">alumno_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="11">tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="11">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>];visitas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E5F4E4"><B>visitas</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alumno_id"><FONT POINT-SIZE="11">alumno_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entrada"><FONT POINT-SIZE="11">entrada</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="salida"><FONT POINT-SIZE="11">salida</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cierre_automatico"><FONT POINT-SIZE="11">cierre_automatico</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">boolean</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>];turnos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E5F4E4"><B>turnos</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alumno_id"><FONT POINT-SIZE="11">alumno_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero"><FONT POINT-SIZE="11">numero</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="11">estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="11">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="llamado_en"><FONT POINT-SIZE="11">llamado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>];alumnos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E5F4E4"><B>alumnos</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perfil_id"><FONT POINT-SIZE="11">perfil_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">FK, UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="11">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rut"><FONT POINT-SIZE="11">rut</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="carrera"><FONT POINT-SIZE="11">carrera</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="certificado_hasta"><FONT POINT-SIZE="11">certificado_hasta</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="objetivo"><FONT POINT-SIZE="11">objetivo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nivel"><FONT POINT-SIZE="11">nivel</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="11">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>]; }
subgraph cluster_acceso { label=<<B>Acceso y roles</B>>; fontsize=13; style="rounded"; color="#BBBBBB"; perfiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#E7F1FB"><B>perfiles</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">uuid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="11">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rol"><FONT POINT-SIZE="11">rol</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="11">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>]; }
subgraph cluster_param { label=<<B>Parámetros y estado en vivo</B>>; fontsize=13; style="rounded"; color="#BBBBBB"; configuracion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#F9EEDA"><B>configuracion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacidad"><FONT POINT-SIZE="11">capacidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="horario"><FONT POINT-SIZE="11">horario</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">jsonb</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="periodo_inicio"><FONT POINT-SIZE="11">periodo_inicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="periodo_fin"><FONT POINT-SIZE="11">periodo_fin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cierre_automatico_horas"><FONT POINT-SIZE="11">cierre_automatico_horas</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="turno_expira_minutos"><FONT POINT-SIZE="11">turno_expira_minutos</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="umbral_casi_lleno"><FONT POINT-SIZE="11">umbral_casi_lleno</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="progresion"><FONT POINT-SIZE="11">progresion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">jsonb</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="modalidades_rutina"><FONT POINT-SIZE="11">modalidades_rutina</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">jsonb</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>];aforo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#F9EEDA"><B>aforo</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ocupacion"><FONT POINT-SIZE="11">ocupacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacidad"><FONT POINT-SIZE="11">capacidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="turno_llamado"><FONT POINT-SIZE="11">turno_llamado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="en_espera"><FONT POINT-SIZE="11">en_espera</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="umbral_casi_lleno"><FONT POINT-SIZE="11">umbral_casi_lleno</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en"><FONT POINT-SIZE="11">actualizado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>]; }
subgraph cluster_cat { label=<<B>Catálogo del gimnasio</B>>; fontsize=13; style="rounded"; color="#BBBBBB"; maquinas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#EFEDFF"><B>maquinas</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">bigint</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="11">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ejercicio"><FONT POINT-SIZE="11">ejercicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grupo_muscular"><FONT POINT-SIZE="11">grupo_muscular</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="patron_movimiento"><FONT POINT-SIZE="11">patron_movimiento</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ajustes"><FONT POINT-SIZE="11">ajustes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad"><FONT POINT-SIZE="11">cantidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="11">estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="foto_url"><FONT POINT-SIZE="11">foto_url</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="11">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>];implementos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#555555"><TR><TD COLSPAN="3" BGCOLOR="#EFEDFF"><B>implementos</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="11"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">bigint</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="11">nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="categoria"><FONT POINT-SIZE="11">categoria</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad_total"><FONT POINT-SIZE="11">cantidad_total</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">integer</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en"><FONT POINT-SIZE="11">creado_en</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#B03A2E"> </FONT></TD></TR></TABLE>>]; }
{rank=same; tarjetas; visitas; turnos;}
{rank=same; alumnos; configuracion;}
{rank=same; perfiles; aforo;}
{rank=same; auth_users; maquinas; implementos;}
tarjetas:alumno_id -> alumnos:id [label="N : 1", arrowhead=none];
turnos:alumno_id -> alumnos:id [label="N : 1", arrowhead=none];
visitas:alumno_id -> alumnos:id [label="N : 1 · una abierta por alumno", arrowhead=none];
alumnos:perfil_id -> perfiles:id [label="0..1 : 1", arrowhead=none];
perfiles -> auth_users [label="1 : 1", arrowhead=none, style=dashed];
configuracion -> aforo [label="disparador: al cambiar la capacidad", style=dashed, color="#B9770E", fontcolor="#B9770E"];
visitas -> aforo [label="registrar_ingreso recalcula ocupación y espera", style=dashed, color="#B9770E", fontcolor="#B9770E", constraint=false];
aforo -> maquinas [style=invis];
nota [shape=note, fontsize=11, style=filled, fillcolor="#F0EFEC", label="Diseñadas y pendientes según el CR-01:\nrutinas, ejercicios y feedback\npréstamos y devoluciones\nregistro corporal"];
{rank=same; nota; auth_users;}
}